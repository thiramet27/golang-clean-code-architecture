# Copy to .env (same GOAPP_* names as the Go template's env.template)
GOAPP_ENV=development
GOAPP_HOST=127.0.0.1
GOAPP_PORT=3000
GOAPP_NAME=PYTHON CLEAN API
GOAPP_VERSION=0.1.0

GOAPP_POSTGRES_DB_NAME=postgres
GOAPP_POSTGRES_DB_USER=postgres
GOAPP_POSTGRES_DB_PASSWORD=golang-first-api
GOAPP_POSTGRES_DB_HOST=localhost
GOAPP_POSTGRES_DB_PORT=5432
# Run without Postgres: GOAPP_DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Optional: enables the MongoDB example model (/api/v1/data/products/)
# GOAPP_MONGODB_DB_ATLAS_URI=mongodb://root:golang-first-api@127.0.0.1:27017/?authSource=admin
GOAPP_MONGODB_DB_NAME=python_cleancode_example

# Must be >= 32 random chars when GOAPP_ENV=production
GOAPP_SECRET_KEY=change-me
GOAPP_JWT_ACCESS_EXPIRES=86400
GOAPP_JWT_REFRESH_EXPIRES=172800
GOAPP_CORS_ORIGINS=["http://localhost:5173"]
