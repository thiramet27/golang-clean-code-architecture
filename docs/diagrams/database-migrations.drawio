<mxfile host="drawio"><diagram name="database-migrations" id="database-migrations"><mxGraphModel dx="1320" dy="720" grid="0" gridSize="10" guides="1" page="0" pageScale="1" pageWidth="1320" pageHeight="720" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="bg" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1320" height="720" as="geometry"/></mxCell><mxCell id="c1" value="Database and migrations: SQLAlchemy ORM + Alembic" style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=20;fontColor=#0F172A;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1200" height="30" as="geometry"/></mxCell><mxCell id="c2" value="The schema lives in code and in versioned migration files, and the database records which version it is on." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontColor=#64748B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="46" width="1260" height="22" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:13px;color:#0F172A&quot;&gt;ORM models&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;postgres/models.py&lt;br&gt;SQLAlchemy 2 typed&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;spacingRight=8;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;shadow=0;" vertex="1" parent="1"><mxGeometry x="30" y="96" width="220" height="92" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1"><mxGeometry x="42" y="125.0" width="34" height="34" as="geometry"/></mxCell><mxCell i