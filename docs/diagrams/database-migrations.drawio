_name&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;varchar(100)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;password&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;bcrypt · hidden from /data&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;created_at&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;updated_at&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336791;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=12;overflow=fill;" vertex="1" parent="1"><mxGeometry x="270" y="270" width="230" height="165" as="geometry"/></mxCell><mxCell id="c25" value="&lt;div style=&#x27;background:#336791;color:#fff;font-weight:bold;padding:6px 8px;text-align:left&#x27;&gt;user_tokens&lt;/div&gt;&lt;table style=&#x27;width:100%;font-size:11px;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;integer · PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;user_id&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;FK · unique · cascade&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;access&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;sha256 digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;refresh&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;sha256 digest&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;updated_at&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336791;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=12;overflow=fill;" vertex="1" parent="1"><mxGeometry x="52" y="500" width="230" height="127" as="geometry"/></mxCell><mxCell id="c26" value="&lt;div style=&#x27;background:#336791;color:#fff;font-weight:bold;padding:6px 8px;text-align:left&#x27;&gt;user_permissions&lt;/div&gt;&lt;table style=&#x27;width:100%;font-size:11px;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;&lt;b&gt;id&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;integer · PK&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;user_id&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;FK · index · cascade&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;permission&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;varchar(50)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:3px 8px;color:#0F172A&#x27;&gt;updated_at&lt;/td&gt;&lt;td style=&#x27;padding:3px 8px;color:#64748B&#x27;&gt;timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#336791;strokeWidth=1.5;align=left;verticalAlign=top;spacing=0;fontFamily=Helvetica;fontSize=12;overflow=fill;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="230" height="108" as="geometry"/></mxCell><mxCell id="c27" value="one session per user" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#336791;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c28" value="permissions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#336791;strokeWidth=1.5;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;labelBackgroundColor=#F8FAFC;" edge="1" parent="1" source="c24" target="c26"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="Login writes the session with &lt;b&gt;INSERT … ON CONFLICT (user_id) DO UPDATE&lt;/b&gt;, so two logins at once can&#x27;t collide on the unique key." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="52" y="636" width="680" height="50" as="geometry"/></mxCell><mxCell id="c30" value="Why Alembic instead of AutoMigrate" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C4B5FD;strokeWidth=1.5;dashed=0;verticalAlign=top;align=left;spacingLeft=44;spacingTop=10;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;fontStyle=1;container=0;" vertex="1" parent="1"><mxGeometry x="780" y="226" width="510" height="470" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=image;image=data:image/svg+xml,;imageAspect=1;aspect=fixed;verticalLabelPosition=bottom;html=1;" vertex="1" parent="1"><mxGeometry x="792" y="235" width="24" height="24" as="geometry"/></mxCell><mxCell id="c32" value="&lt;table style=&#x27;width:100%;font-size:12px;border-collapse:collapse&#x27;&gt;&lt;tr&gt;&lt;td&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#64748B&#x27;&gt;&lt;b&gt;Go · GORM AutoMigrate&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#64748B&#x27;&gt;&lt;b&gt;Python · Alembic&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:6px 8px;color:#0F172A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;b&gt;History of changes&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#DC2626;border-top:1px solid #E2E8F0&#x27;&gt;none&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#16A34A;border-top:1px solid #E2E8F0&#x27;&gt;one file per change, in git&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:6px 8px;color:#0F172A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;b&gt;Code review&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#DC2626;border-top:1px solid #E2E8F0&#x27;&gt;happens at runtime&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#16A34A;border-top:1px solid #E2E8F0&#x27;&gt;reviewed in the PR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:6px 8px;color:#0F172A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;b&gt;Rollback&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#DC2626;border-top:1px solid #E2E8F0&#x27;&gt;not possible&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#16A34A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;code&gt;downgrade()&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:6px 8px;color:#0F172A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;b&gt;Rename / drop column&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#DC2626;border-top:1px solid #E2E8F0&#x27;&gt;never does it&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#16A34A;border-top:1px solid #E2E8F0&#x27;&gt;explicit operations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:6px 8px;color:#0F172A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;b&gt;When it runs&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#DC2626;border-top:1px solid #E2E8F0&#x27;&gt;manual &lt;code&gt;go run …/migration&lt;/code&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#16A34A;border-top:1px solid #E2E8F0&#x27;&gt;automatically before start&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#x27;padding:6px 8px;color:#0F172A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;b&gt;DB knows its version&lt;/b&gt;&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#DC2626;border-top:1px solid #E2E8F0&#x27;&gt;no&lt;/td&gt;&lt;td style=&#x27;padding:6px 8px;color:#16A34A;border-top:1px solid #E2E8F0&#x27;&gt;&lt;code&gt;alembic_version&lt;/code&gt; table&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;overflow=fill;" vertex="1" parent="1"><mxGeometry x="796" y="270" width="478" height="300" as="geometry"/></mxCell><mxCell id="c33" value="Add a column: edit &lt;code&gt;models.py&lt;/code&gt; → &lt;code&gt;alembic revision --autogenerate -m &quot;add phone&quot;&lt;/code&gt; → review the generated file → merge. The next deploy applies it before the new code serves traffic." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;fontColor=#0F172A;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="796" y="560" width="478" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>